rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Validación de tamaño de campos ────────────────────────────────
    // Protección contra abuso de costo: sin esto, cualquier cuenta
    // autenticada (comprometida o atacada con su propio token válido)
    // podía escribir campos de texto o arreglos de tamaño ilimitado en un
    // solo documento. Firestore ya rechaza un documento de más de 1 MiB,
    // pero un solo campo gigante (ej. una nota de 900 KB) o un arreglo que
    // crece sin límite con cada actualización (stats, vacunas, fotos)
    // llega a ese límite fácilmente y encarece cada lectura posterior del
    // mismo documento. Los límites de abajo son generosos — muy por
    // encima de cualquier uso real — para no afectar el uso normal.
    function strOk(data, field, maxLen) {
      return !(field in data) || data[field] == null
             || !(data[field] is string) || data[field].size() <= maxLen;
    }

    function listOk(data, field, maxLen) {
      return !(field in data) || data[field] == null
             || !(data[field] is list) || data[field].size() <= maxLen;
    }

    function userDataOk(data) {
      return strOk(data, 'name', 150)
          && strOk(data, 'email', 320)
          && strOk(data, 'currentRanchId', 200);
    }

    function ranchDataOk(data) {
      return strOk(data, 'name', 150)
          && strOk(data, 'location', 300);
    }

    function animalDataOk(data) {
      return strOk(data, 'name', 150)
          && strOk(data, 'earTagNumber', 60)
          && strOk(data, 'legNumber', 60)
          && strOk(data, 'location', 150)
          && strOk(data, 'breed', 100)
          && strOk(data, 'sex', 30)
          && strOk(data, 'purpose', 60)
          && strOk(data, 'status', 30)
          && strOk(data, 'registrationNumber', 100)
          && strOk(data, 'father', 100)
          && strOk(data, 'mother', 100)
          && strOk(data, 'diseaseResistance', 5000)
          && strOk(data, 'fertilityInfo', 5000)
          && strOk(data, 'geneticMarkers', 5000)
          && strOk(data, 'description', 5000)
          && strOk(data, 'profileImageUrl', 2000)
          && strOk(data, 'exitReason', 60)
          && strOk(data, 'exitNotes', 2000)
          && listOk(data, 'imageUrls', 30)
          && listOk(data, 'stats', 5000)
          && listOk(data, 'vaccinations', 1000);
    }

    function productDataOk(data) {
      return strOk(data, 'name', 150)
          && strOk(data, 'category', 100)
          && strOk(data, 'subCategory', 100)
          && strOk(data, 'unit', 30)
          && strOk(data, 'notes', 2000);
    }

    function transactionDataOk(data) {
      return strOk(data, 'type', 30)
          && strOk(data, 'category', 100)
          && strOk(data, 'subCategory', 100)
          && strOk(data, 'notes', 2000)
          && strOk(data, 'animalId', 200);
    }

    function calendarEventDataOk(data) {
      return strOk(data, 'title', 200)
          && strOk(data, 'description', 2000)
          && strOk(data, 'category', 100);
    }

    function listingDataOk(data) {
      return strOk(data, 'animalName', 150)
          && strOk(data, 'description', 5000)
          && strOk(data, 'locationState', 100)
          && strOk(data, 'locationMunicipality', 150)
          && strOk(data, 'contactPhone', 30)
          && strOk(data, 'breed', 100)
          && strOk(data, 'certifications', 2000)
          && strOk(data, 'status', 30)
          && strOk(data, 'sex', 30)
          && strOk(data, 'purpose', 60)
          && listOk(data, 'imageUrls', 30)
          && listOk(data, 'vaccinations', 1000);
    }

    // ── Noticias globales ─────────────────────────────────────
    match /global_news/{newsId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Marketplace ───────────────────────────────────────────
    match /marketplace_listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && listingDataOk(request.resource.data);
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && listingDataOk(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ── Usuarios ──────────────────────────────────────────────
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId
                    && userDataOk(request.resource.data);
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && userDataOk(request.resource.data);

      // Ranchos y sus subcolecciones
      match /ranches/{ranchId} {
        allow read, delete: if request.auth != null
                            && request.auth.uid == userId;
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && ranchDataOk(request.resource.data);

        match /animals/{animalId} {
          allow read, delete: if request.auth != null
                              && request.auth.uid == userId;
          allow create, update: if request.auth != null
                                && request.auth.uid == userId
                                && animalDataOk(request.resource.data);
        }
        match /products/{productId} {
          allow read, delete: if request.auth != null
                              && request.auth.uid == userId;
          allow create, update: if request.auth != null
                                && request.auth.uid == userId
                                && productDataOk(request.resource.data);
        }
        match /transactions/{transactionId} {
          allow read, delete: if request.auth != null
                              && request.auth.uid == userId;
          allow create, update: if request.auth != null
                                && request.auth.uid == userId
                                && transactionDataOk(request.resource.data);
        }
        match /calendarEvents/{eventId} {
          allow read, delete: if request.auth != null
                              && request.auth.uid == userId;
          allow create, update: if request.auth != null
                                && request.auth.uid == userId
                                && calendarEventDataOk(request.resource.data);
        }
      }

      // Registros de análisis IA
      match /analysis_records/{recordId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Notificaciones in-app
      match /inAppNotifications/{notificationId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Cuota de IA (dailyUsed, paidConsults, isPremium, etc.)
      match /ai_usage/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Historial de compras IAP
      // Guardamos cada transacción aquí para auditoría y evitar duplicados
      match /purchases/{purchaseId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }
  }
}
